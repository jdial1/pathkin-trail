{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Pathkin Trail traits pack",
 "type": "object",
 "required": [
  "packVersion",
  "rosterSize",
  "partyMax",
  "slots"
 ],
 "properties": {
  "packVersion": {
   "type": "integer",
   "minimum": 1
  },
  "rosterSize": {
   "type": "integer",
   "minimum": 1
  },
  "partyMax": {
   "type": "integer",
   "minimum": 1
  },
  "slots": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "id",
     "values"
    ],
    "properties": {
     "id": {
      "type": "string",
      "minLength": 1
     },
     "values": {
      "type": "array",
      "minItems": 2,
      "items": {
       "type": [
        "string",
        "integer"
       ]
      }
     }
    },
    "additionalProperties": false
   }
  }
 },
 "additionalProperties": false
}

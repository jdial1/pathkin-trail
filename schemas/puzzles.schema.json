      ],
      "properties": {
       "slotCount": {
        "type": "integer",
        "minimum": 1
       },
       "forms": {
        "type": "array",
        "items": {
         "type": "string",
         "minLength": 1
        }
       },
       "examples": {
        "type": "integer",
        "minimum": 0
       },
       "sends": {
        "type": "array",
        "minItems": 2,
        "items": {
         "type": "integer",
         "minimum": 1
        }
       },

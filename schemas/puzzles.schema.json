{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Pathkin Trail puzzles pack",
 "type": "object",
 "required": [
  "packVersion",
  "tierOrder",
  "tiers",
  "tierSets",
  "puzzles"
 ],
 "properties": {
  "packVersion": {
   "type": "integer",
   "minimum": 1
  },
  "tierOrder": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "string",
    "enum": [
     "gentle",
     "steady",
     "hard",
     "expert"
    ]
   }
  },
  "tiers": {
   "type": "object",
   "required": [
    "gentle",
    "steady",
    "hard",
    "expert"
   ],
   "properties": {
    "gentle": {
     "type": "object",
     "required": [
      "patience",
      "sends"
     ],
     "properties": {
      "patience": {
       "type": "integer",
       "minimum": 1
      },
      "sends": {
       "type": "array",
       "minItems": 2,
       "items": {
        "type": "integer",
        "minimum": 1
       }
      }
     },
     "additionalProperties": false
    },
    "steady": {
     "type": "object",

   "items": {
    "type": "object",
    "required": [
     "id",
     "family",
     "title",
     "blurb",
     "params",
     "slots"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^p_[a-z0-9_]+$"
     },
     "family": {
      "type": "string",
      "minLength": 1
     },
     "tierSet": {
      "type": "string",
      "minLength": 1
     },
     "title": {
      "type": "string",
      "pattern": "^loc:[a-zA-Z0-9_.]+$"
     },
     "blurb": {
      "type": "string",
      "pattern": "^loc:[a-zA-Z0-9_.]+$"
     },
     "params": {
      "type": "object"
     },
     "slots": {
      "type": "array",
      "minItems": 1,
      "items": {

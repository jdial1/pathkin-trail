        }
       },
       "kinds": {
        "type": "integer",
        "minimum": 1
       },
       "items": {
        "type": "integer",
        "minimum": 2
       },
       "keepers": {
        "type": "integer",
        "minimum": 1
       },
       "rounds": {
        "type": "integer",
        "minimum": 1
       },
       "reveal": {
        "type": "integer",
        "minimum": 0
       },
       "hidden": {
        "type": "integer",
        "minimum": 0

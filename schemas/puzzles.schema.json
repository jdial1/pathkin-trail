        "type": "integer",
        "minimum": 1
       }
      }
     },
     "additionalProperties": false
    },
    "expert": {
     "type": "object",
     "required": [
      "patience",
      "sends"
     ],
     "properties": {
      "patience": {
       "type": "integer",
       "minimum": 1
      },
      "sends": {
       "type": "array",
       "minItems": 2,
       "items": {
        "type": "integer",
